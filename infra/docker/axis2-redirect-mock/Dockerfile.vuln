# Axis2 default-credentials mock — modern-release (>= 1.7.3) REDIRECT variant.
# Same server.py as infra/docker/axis2-mock/ (kept byte-identical); this image
# only differs by defaulting AXIS2_MODE to the redirect flow, so `task build`
# auto-discovers it and `task test` exercises the post-login 30x redirect
# branch of the CVE-2010-0219 feed (which the root-context direct images do not).
FROM python:3.11-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir /certs \
    && openssl req -x509 -newkey rsa:2048 -keyout /certs/server.key \
       -out /certs/server.crt -days 3650 -nodes \
       -subj "/CN=noctis-mock"
COPY server.py /app/server.py
ENV AXIS2_MODE=vuln_redirect
EXPOSE 80 443
CMD ["python3", "/app/server.py"]
